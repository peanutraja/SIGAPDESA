APP_NAME=SIGAPDESA
APP_ENV=production
# Diisi otomatis oleh deploy/build-hosting.sh (jangan dibagikan)
APP_KEY=
# WAJIB false di hosting: kalau true, error menampilkan password database ke pengunjung
APP_DEBUG=false
# Ganti dengan alamat situs, pakai https:// bila SSL aktif (tanpa garis miring di akhir)
APP_URL=https://NAMA-SITUS-ANDA

LOG_CHANNEL=single
LOG_LEVEL=error

# Lihat di panel hosting → MySQL Databases.
# InfinityFree: host berbentuk sqlXXX.infinityfree.com, nama DB & user berawalan if0_xxxxx
# Hostinger   : host biasanya localhost, nama DB & user berawalan u123456789_
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# true bila APP_URL memakai https://
SESSION_SECURE_COOKIE=true

# Zona rumah dihitung dari layer InaRISK ini (lihat config/inarisk.php)
INARISK_ZONA_LAYER=multi
